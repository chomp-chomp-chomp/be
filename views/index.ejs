<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Baking Experience</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">
    <div class="card">

      <header class="site-header">
        <img src="https://ik.imagekit.io/chompchomp/Baking%20Experience%20logo" alt="The Baking Experience" width="440">
        <p>Stories &bull; Recipes &bull; Culture &bull; Tradition</p>
      </header>

      <div class="post-list">
        <% if (posts.length === 0) { %>
          <div class="not-found">
            <p>No posts yet.</p>
          </div>
        <% } %>
        <% posts.forEach(post => { %>
          <div class="post-list-item">
            <span class="date"><%= formatDate(post.date) %></span>
            <div>
              <a href="/<%= post.slug %>">
                <div class="title"><%= post.title %></div>
                <% if (post.excerpt) { %>
                  <div class="excerpt"><%= post.excerpt %></div>
                <% } %>
              </a>
            </div>
          </div>
        <% }) %>
      </div>

    </div>
  </div>
</body>
</html>
