<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Baking Experience</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="page">
    <div class="card">

      <header class="site-header">
        <img src="https://ik.imagekit.io/chompchomp/Baking%20Experience%20logo" alt="The Baking Experience" width="440">
        <p class="site-tagline">Stories &bull; Recipes &bull; Culture &bull; Tradition</p>
      </header>

      <div class="post-list">
        <% if (posts.length === 0) { %>
          <p class="empty">No posts yet.</p>
        <% } %>
        <% posts.forEach(post => { %>
          <a class="post-list-item" href="<%= post.slug %>/">
            <div class="post-list-meta">
              <span class="post-list-date"><%= formatDate(post.date) %></span>
              <% if (post.eyebrow) { %><span class="post-list-eyebrow"><%= post.eyebrow %></span><% } %>
            </div>
            <div class="post-list-title"><%= post.title %></div>
            <% if (post.excerpt) { %>
              <div class="post-list-excerpt"><%= post.excerpt %></div>
            <% } %>
          </a>
        <% }) %>
      </div>

      <footer class="site-footer">
        <p>The Baking Experience &mdash; a Skadden Experience Employee Group</p>
      </footer>

    </div>
  </div>
</body>
</html>
