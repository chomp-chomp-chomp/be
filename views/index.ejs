<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ps.</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=EB+Garamond:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="page">

    <header class="ps-header">
      <div class="header-bar">
        <a href="https://chom.ps" class="chomp-home-link" title="chom.ps">
          <span class="icon-cookie">🍪</span><span class="icon-heart">♥</span>
        </a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false">
          <span class="nav-toggle-icon">☰</span>
          <span class="nav-toggle-close">✕</span>
        </button>
      </div>
      <nav class="sandwich-nav" id="sandwich-nav">
        <a href="https://chom.ps">Chomp</a>
        <a href="https://chom.ps/about">About</a>
        <a href="https://chom.ps/store">Store</a>
        <a href="https://chom.ps/tools/">Lab</a>
        <a href="https://chom.ps/tools/ipsum">Ipsum</a>
      </nav>
      <div class="ps-banner">
        <img src="https://ik.imagekit.io/chompchomp/postscript%20light" alt="postscript" class="banner-light">
        <img src="https://ik.imagekit.io/chompchomp/postscript%20dark" alt="postscript" class="banner-dark">
      </div>
    </header>

    <div class="post-list">
      <% if (posts.length === 0) { %>
        <p class="empty">No posts yet.</p>
      <% } %>
      <% posts.slice(0, 10).forEach(post => { %>
        <a class="post-list-item" href="<%= post.slug %>/">
          <div class="post-list-meta">
            <span class="post-list-date"><%= formatDate(post.date) %></span>
            <% if (post.eyebrow) { %><span class="post-list-eyebrow"><%= post.eyebrow %></span><% } %>
          </div>
          <div class="post-list-title"><%= post.title %></div>
          <% if (post.excerpt) { %>
            <div class="post-list-excerpt"><%= post.excerpt %></div>
          <% } %>
        </a>
      <% }) %>
      <% if (posts.length > 10) { %>
        <a class="post-list-more" href="archive/">All posts →</a>
      <% } %>
    </div>

    <footer class="site-colophon">
      <div class="colophon-inner">
        <div class="colophon-line">An archive of zen baking and chomp theory</div>
        <div class="colophon-line small"><a href="https://chom.ps">chom.ps</a></div>
      </div>
    </footer>

  </div>
  <script>
    (function () {
      var btn = document.querySelector('.nav-toggle');
      var nav = document.getElementById('sandwich-nav');
      if (btn && nav) {
        btn.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open);
        });
      }
    })();
  </script>
</body>
</html>
