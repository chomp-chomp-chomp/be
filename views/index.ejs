<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Baking Experience</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=EB+Garamond:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="page">

    <header class="be-header">
      <div class="be-banner">
        <img src="https://ik.imagekit.io/chompchomp/light%20be%20heart%20banner" alt="be" class="banner-light">
        <img src="https://ik.imagekit.io/chompchomp/dark%20be%20heart%20banner" alt="be" class="banner-dark">
      </div>
      <div class="be-subtitle">
        <div class="be-subtitle-main smallcaps">Cookies, etc., etc.</div>
        <div class="be-subtitle-aside">(and so on)</div>
      </div>
      <div class="site-tagline">
        Imposing form upon chaos<br>
        and chaos upon form.<br>
        Calling it dessert.
      </div>
    </header>

    <div class="post-list">
      <% if (posts.length === 0) { %>
        <p class="empty">No posts yet.</p>
      <% } %>
      <% posts.forEach(post => { %>
        <a class="post-list-item" href="<%= post.slug %>/">
          <div class="post-list-meta">
            <span class="post-list-date"><%= formatDate(post.date) %></span>
            <% if (post.eyebrow) { %><span class="post-list-eyebrow"><%= post.eyebrow %></span><% } %>
          </div>
          <div class="post-list-title"><%= post.title %></div>
          <% if (post.excerpt) { %>
            <div class="post-list-excerpt"><%= post.excerpt %></div>
          <% } %>
        </a>
      <% }) %>
    </div>

    <footer class="site-colophon">
      <div class="colophon-inner">
        <div class="colophon-line">Recipes &bull; Rituals &bull; Insights &bull; Connections</div>
        <div class="colophon-line">Archive of Zen Baking and Chomp Theory</div>
        <div class="colophon-line small"><a href="https://chom.ps">chom.ps</a></div>
      </div>
    </footer>

  </div>
</body>
</html>
