<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> – The Baking Experience</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Source+Sans+3:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <div class="page">
    <div class="card">

      <header class="post-header">
        <a class="post-header-home" href="../">The Baking Experience</a>
        <% if (post.eyebrow) { %>
          <p class="eyebrow"><%= post.eyebrow %></p>
        <% } %>
        <h1 class="post-title"><%= post.title %></h1>
        <p class="post-date"><%= formatDate(post.date) %></p>
      </header>

      <div class="post-body">
        <%- post.contentHtml %>
      </div>

      <footer class="post-footer">
        <a href="../">&larr; All posts</a>
        <span class="post-footer-tagline">Stories &bull; Recipes &bull; Culture &bull; Tradition</span>
      </footer>

    </div>
  </div>
</body>
</html>
