<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> – The Baking Experience</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=EB+Garamond:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../style.css">
</head>
<body>
  <div class="page">

    <nav class="site-nav">
      <a href="../">← The Baking Experience</a>
    </nav>

    <header class="post-header">
      <% if (post.eyebrow) { %><p class="kicker"><%= post.eyebrow %></p><% } %>
      <h1><%= post.title %></h1>
      <p class="meta"><%= formatDate(post.date) %></p>
      <hr>
    </header>

    <div class="post-body markdown<%= post.mode ? ' ' + post.mode : '' %>">
      <%- post.contentHtml %>
    </div>

    <div class="post-back">
      <a href="../">← All posts</a>
    </div>

    <footer class="site-colophon">
      <div class="colophon-inner">
        <div class="colophon-line">Recipes &bull; Rituals &bull; Insights &bull; Connections</div>
        <div class="colophon-line">Archive of Zen Baking and Chomp Theory</div>
        <div class="colophon-line small"><a href="https://chom.ps">chom.ps</a></div>
      </div>
    </footer>

  </div>
</body>
</html>
